# =============================================================================
# .env.example — OMOP Dev Workspace Environment Variables (SHARED)
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Scope: this file contains ONLY variables shared across every analysis in
# this workspace (SQL Server container, API keys, base OMOP connection
# details, JDBC wrapper). Analysis-specific values (CDM/results schemas,
# CDM metadata, GitHub/GitLab remotes, BUNDLE_*/PRCC_* git identity) live
# in each study's own .env / .env.example.
#
# IMPORTANT: Never commit .env to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# SQL Server Docker (shared container — docker-compose.yml)
# -----------------------------------------------------------------------------
# SA password requirements: 8+ chars, upper, lower, digit, special character.
# Do NOT use ! (Bash history expansion will fail). Good examples:
#   SqlServer@2024  |  Dev#OMOP$Vocab1  |  MyStudy123%Pass
MSSQL_SA_PASSWORD=YourStrong@Passw0rd

# SQL Server edition (Developer is free for dev/test use)
# Options: Developer | Express | Standard | Enterprise | EnterpriseCore
MSSQL_PID=Developer

# Host port to expose SQL Server on (default: 1433)
MSSQL_PORT=1433

# -----------------------------------------------------------------------------
# Global
# -----------------------------------------------------------------------------
CRAN_MIRROR=https://cloud.r-project.org/

# Claude / Anthropic API key for coding assistant access
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# GitHub Personal Access Token — used for TWO purposes inside the devcontainer:
#
#  1. GitHub CLI (`gh`) — enables AI-assisted commits, PR creation, and merges
#     without an interactive `gh auth login` each time.
#
#  2. renv package restore — HADES packages (DatabaseConnector, SqlRender, etc.)
#     are hosted on GitHub, not CRAN. The devcontainer maps GH_TOKEN → GITHUB_PAT
#     so renv can authenticate GitHub API calls during the postCreate restore.
#     Without this, unauthenticated requests are capped at 60/hour per IP address,
#     which is easily exhausted on a shared university network and will cause the
#     container's postCreate package restore to fail with a rate-limit error.
#
# One token covers both uses. Create a fine-grained PAT with these scopes:
#   - Contents: Read-only  (clone/download packages and repos)
#   - Pull requests: Read and write  (open and merge PRs via gh)
#   https://github.com/settings/personal-access-tokens/new
#
# Leave blank only if you will run `gh auth login` interactively AND your
# network is not rate-limited (i.e. not on a shared university IP).
GH_TOKEN=your_github_pat_here

# -----------------------------------------------------------------------------
# Zotero (MCP server — reference management in AI-assisted analysis sessions)
# -----------------------------------------------------------------------------
# API key: https://www.zotero.org/settings/keys  (read-only scope is sufficient)
ZOTERO_API_KEY=your_zotero_api_key_here

# Group library ID — visible in the URL at zotero.org/groups/<ID>/library
ZOTERO_GROUP_ID=your_group_id_here

# -----------------------------------------------------------------------------
# Open Science Framework (OSF — study protocol hosting and versioning)
# -----------------------------------------------------------------------------
# Personal access token used by scripts/osf_sync.R (osfr package) to create
# one OSF project per registered study and upload/version protocol documents
# listed in osf/osf_files.csv.
#
# Create a token at: https://osf.io/settings/tokens
#   Required scope: osf.full_write
#
# Notes:
#   - Projects are created PRIVATE, and drafts MUST stay private until the
#     study team approves them for public release (see osf/README.md).
#     Making a project public (and minting a DOI) is a deliberate manual
#     step on osf.io — the sync script never changes visibility.
#   - Registrations/preregistrations cannot be created via the API; draft
#     them from the study repo and submit through the OSF web UI.
OSF_PAT=your_osf_token_here

# -----------------------------------------------------------------------------
# Local Synthetic OMOP Database — connection details only (shared)
# Per-analysis CDM/results schemas and CDM metadata live in each study's .env.
# -----------------------------------------------------------------------------
LOCAL_OMOP_SERVER=localhost
LOCAL_OMOP_DATABASE=omop_synth
LOCAL_OMOP_VOCAB_SCHEMA=omop_vocab
LOCAL_OMOP_SPN_HOST=localhost

# Local SQL Server container connection
MSSQL_USER=SA

# NOTE: MSSQL_HOST is intentionally NOT set here.
#   - Inside the dev container, docker-compose injects MSSQL_HOST=mssql_dev
#     (from DEVCONTAINER_MSSQL_HOST below) so R reaches the SQL Server service.
#   - On the host (outside the container), config.R defaults to "localhost".
# Setting MSSQL_HOST=localhost here would override the container value and make
# every script connect to localhost:1433 inside the container (connection
# refused / cannot open database). Leave it unset; only add it if you are
# pointing at a non-default SQL Server host.

# Dev container internal host defaults (container-to-container DNS)
# Override these only if your SQL service/container name is different.
DEVCONTAINER_MSSQL_HOST=mssql_dev
DEVCONTAINER_OMOP_SERVER=mssql_dev

# -----------------------------------------------------------------------------
# Institutional OMOP Database (shared across all analyses at this institution)
# Used by each study's bundle-building step (site-deploy-bound packaging) to
# populate the portable bundle's .env. The bundle's own config reads these as
# OMOP_* at run time. Local dev schemas live in each study's study_params.yaml.
# -----------------------------------------------------------------------------
INST_OMOP_SERVER=your.institution.server.edu
INST_OMOP_DATABASE=YOUR_DATABASE
INST_OMOP_VOCAB_SCHEMA=OMOP_VOCAB_SCHEMA
INST_OMOP_SPN_HOST=your.institution.server.edu

# Institutional CDM schema and personal write schema (shared)
INST_OMOP_CDM_SCHEMA=cdm_your_institution
INST_OMOP_RESULTS_SCHEMA=your_results_schema

# Institutional CDM metadata (written into bundle output files and reports)
INST_OMOP_CDM_DATABASE_ID=institution_omop_v5.4
INST_OMOP_CDM_DATABASE_NAME=Institution OMOP CDM
INST_OMOP_CDM_DATABASE_DESCRIPTION=Description of the institutional OMOP CDM database.

# Optional PAT_ID lookup table — maps OMOP person_id to Epic / Clarity PAT_ID.
# Format: [database].[schema].[table_name]. Leave blank to skip the join.
INST_OMOP_PAT_ID_TABLE=

# Optional institution JDBC wrapper JAR (leave blank if not used)
OMOP_HPC_JAR=

# -----------------------------------------------------------------------------
# Runtime OMOP_* connection defaults
# Mapped to LOCAL profile so workspace-level scripts (vocab queries,
# pre-flight checks) have a working connection without a study .env.
# The per-study .env sets OMOP_CDM_SCHEMA / OMOP_RESULTS_SCHEMA / metadata.
# -----------------------------------------------------------------------------
OMOP_SERVER=localhost
OMOP_DATABASE=omop_synth
OMOP_VOCAB_SCHEMA=omop_vocab
OMOP_SPN_HOST=localhost

# -----------------------------------------------------------------------------
# Same-machine synthetic dataset overrides (Strategus repos only)
# SAME-MACHINE CONVENIENCE ONLY — points a Strategus repo's cdmDatabaseSchema
# at another study's synthetic CDM (or a view-overlay schema built by
# synthetic_data/scripts/generate_overlay_schema.R) that's already populated
# on THIS SQL Server instance. Never portable across machines — see
# synthetic_data/README.md for the cross-machine reuse tiers.
# -----------------------------------------------------------------------------
OMOP_CDM_SCHEMA_OVERRIDE=
OMOP_RESULTS_SCHEMA_OVERRIDE=

# -----------------------------------------------------------------------------
# Example: an ETL repo's own transportable-bundle settings
# If one of your `etls:` repos (studies.yaml) builds a portable bundle the
# same way an analysis-core repo does, its own workflow/09-equivalent script
# will need settings like these. Rename the variable prefix per ETL repo if
# you have more than one.
# -----------------------------------------------------------------------------

# Remote for the ETL bundle repo (set once that remote exists)
ETL_GITLAB_REMOTE=CHANGE_ME

# Git identity for bundle commits
BUNDLE_GIT_USER_NAME=Your Name
BUNDLE_GIT_USER_EMAIL=your.email@your-institution.edu

# Dedicated ETL write schema (set once your institution provides it)
# This value is injected into the bundle's .env.example at build time.
# Format: schema_name  (e.g. my_etl_schema)
INST_OMOP_RESULTS_SCHEMA=CHANGE_ME
